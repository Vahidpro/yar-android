    <string name="hokm_rule_two">Enter the tricks won by each team separately. The numbers must add up to the configured number of tricks.</string>
    <string name="hokm_rule_three_title">Scoring</string>
    <string name="hokm_rule_three">A team that meets or exceeds its bid earns exactly its bid in points. A team that falls short earns zero for that hand.</string>
